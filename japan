local function saveToHistory(Code, fromSammy)
    if Code == "" then return end
    if not fromSammy then return end  -- NUR von Sammy speichern
    
    local time = os.date("%H:%M:%S")
    table.insert(history, { word = Code, time = time, fromSammy = true })
    
    -- GUI aktualisieren (OHNE neu zu bauen)
    if historyOpen and HistoryGui then
        updateHistoryContent()
    end
end

