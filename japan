    do
        local frameTimes = {}
        local fpsConn
        
        fpsConn = RunService.RenderStepped:Connect(function()
            if not BStats.Parent then
                fpsConn:Disconnect()
                return
            end
            local now = os.clock()
            table.insert(frameTimes, now)
            while frameTimes[1] and now - frameTimes[1] > 1 do
                table.remove(frameTimes, 1)
            end
        end)
        
        task.spawn(function()
            while BStats.Parent do
                local fps = #frameTimes
                if fps < 2 and frameTimes[1] then
                    local span = os.clock() - frameTimes[1]
                    if span > 0 then
                        fps = math.floor(#frameTimes / span + 0.5)
                    end
                end
                
                local ping = 0
                pcall(function()
