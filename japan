local Announcements = nil
local CodeTextBox = nil
local ConfirmButton = nil
local RedemptionRF = nil

local function setupPaths()
    pcall(function()
        local PlayerGui = LocalPlayer:FindFirstChild("PlayerGui")
        if not PlayerGui then return end

        local topNotif = PlayerGui:FindFirstChild("TopNotification")
        if topNotif then
            Announcements = topNotif:FindFirstChild("TopNotification")
        end

        local codes = PlayerGui:FindFirstChild("Codes")
        if codes then
            local codesInner = codes:FindFirstChild("Codes")
            if codesInner then
                local codeRedeem = codesInner:FindFirstChild("CodeRedeem")
                if codeRedeem then
                    CodeTextBox = codeRedeem:FindFirstChild("TextBox")
                    if CodeTextBox then
                        CodeTextBox.TextColor3 = Color3.fromRGB(0, 0, 0)
                    end
                end
                ConfirmButton = codesInner:FindFirstChild("Confirm")
            end
        end
    end)

    pcall(function()
        local rfFolder = ReplicatedStorage:FindFirstChild("RF")
        if rfFolder then
            RedemptionRF = rfFolder:FindFirstChild("RequestRedemption")
        end
        if not RedemptionRF then
            for _, v in ipairs(ReplicatedStorage:GetDescendants()) do
                if v.Name == "RequestRedemption" and v:IsA("RemoteFunction") then
                    RedemptionRF = v
                    break
                end
            end
        end
    end)
end

local function fireSignal(sig)
    if not sig then return end
    pcall(function()
        if getconnections then
            for _, c in ipairs(getconnections(sig)) do
                if c.Fire then c:Fire() end
            end
        end
    end)
    if firesignal then
        pcall(function() firesignal(sig) end)
    end
end

local function triggerSubmit()
    setupPaths()

    if RedemptionRF and CodeTextBox then
        local ok, result = pcall(function()
            return RedemptionRF:InvokeServer(CodeTextBox.Text)
        end)
        if ok then return true end
    end

    if ConfirmButton and ConfirmButton.Parent then
        pcall(function()
            fireSignal(ConfirmButton.MouseButton1Click)
            fireSignal(ConfirmButton.Activated)
            ConfirmButton:CaptureFocus()
            ConfirmButton:ReleaseFocus(true)
        end)
        return true
    end

    local PlayerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if PlayerGui then
        for _, obj in ipairs(PlayerGui:GetDescendants()) do
            if obj:IsA("TextButton") or obj:IsA("ImageButton") then
                local txt = (obj:IsA("TextButton") and obj.Text or ""):lower()
                if txt:find("submit") or txt:find("redeem") or txt:find("confirm") or txt:find("einlösen") then
                    pcall(function()
                        fireSignal(obj.MouseButton1Click)
                        fireSignal(obj.Activated)
                    end)
                    return true
                end
            end
        end
    end

    return false
end

local function addCode(Code)
    if not _G.AutoWriteEnabled then return end
    Code = tostring(Code)
    if Code == "" then return end
    if not CodeTextBox then setupPaths() end
    if not CodeTextBox then return end

    if not collectedSeen[Code] then
        collectedSeen[Code] = true
        table.insert(collectedCodes, Code)
        -- GUI aktualisieren (Collected Label)
        if MainFrame and MainFrame:FindFirstChild("ContentFrame") then
            local collectedLabel = MainFrame.ContentFrame:FindFirstChild("CollectedLabel")
            if collectedLabel then
                collectedLabel.Text = "Collected: " .. #collectedCodes
            end
        end
    end

    if CodeTextBox.Text == "" then
        CodeTextBox.Text = Code
    else
        CodeTextBox.Text = CodeTextBox.Text .. Code
    end

    if _G.AutoSubmitEnabled and #collectedCodes >= _G.SubmitAfterCount then
        task.spawn(function()
            task.wait(0.02)
            local success = false
            for i = 1, _G.SubmitAttempts do
                success = triggerSubmit()
                if success then break end
                task.wait(0.05)
            end
            if success then
                table.clear(collectedCodes)
                table.clear(collectedSeen)
                if MainFrame and MainFrame:FindFirstChild("ContentFrame") then
                    local collectedLabel = MainFrame.ContentFrame:FindFirstChild("CollectedLabel")
                    if collectedLabel then
                        collectedLabel.Text = "Collected: 0"
                    end
                end
                if CodeTextBox then CodeTextBox.Text = "" end
            end
        end)
    end
end

local function watchLabel(Label)
    if not Label:IsA("TextLabel") then return end
    local text = Label.Text
    if text == "" then return

    if _G.RiddleSolverEnabled then
        local answer = answerQuestion(text)
        if answer then
            addCode(answer)
            return
        end
    end

    addCode(text)
end

local function startAnnouncementWatcher()
    setupPaths()
    if not Announcements then return end
    for _, v in ipairs(Announcements:GetDescendants()) do
        watchLabel(v)
    end
    Announcements.DescendantAdded:Connect(watchLabel)
end

