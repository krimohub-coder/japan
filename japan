local function answerQuestion(T)
    if not _G.RS or not T or T == "" then return nil end
    local L = T:lower()
    for K, V in pairs(SAB_DB) do
        if L:find(K) then return V end
    end
    if L:find("first og") or L:find("1st og") then return "STRAWBERRYELEPHANT" end
    if L:find("second og") or L:find("2nd og") then return "MEOWL" end
    if L:find("third og") or L:find("3rd og") then return "SKIBIDITOILET" end
    if L:find("fifth og") or L:find("5th og") then return "JOHNPORK" end
    return nil
end

local function handleIncomingText(TO)
    if not _G.SE then return end
    local T = TO.Text
    if T == "" then return end
    if verifySourceIsSammy(TO) then
        if _G.RS then
            local A = answerQuestion(T)
            if A then
                addCode(A)
                return
            end
        end
        for W in T:gmatch("%S+") do
            addCode(W)
        end
    end
end

local function hookUiTextObject(O)
    if O:IsA("TextLabel") then
        handleIncomingText(O)
        O:GetPropertyChangedSignal("Text"):Connect(function()
            handleIncomingText(O)
        end)
    end
end

local function startPlayerGuiScanner()
    local PG = L:FindFirstChild("PlayerGui")
    if not PG then return end
    for _, D in ipairs(PG:GetDescendants()) do
        hookUiTextObject(D)
    end
    PG.DescendantAdded:Connect(hookUiTextObject)
end

