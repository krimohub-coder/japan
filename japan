local function makeQPDraggable(dragArea, frameToMove)  
    local dragging, dragInput, dragStart, startPos  
    dragArea.InputBegan:Connect(function(input)  
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true  
            dragStart = input.Position  
            startPos = frameToMove.Position  
            input.Changed:Connect(function()  
                if input.UserInputState == Enum.UserInputState.End then dragging = false end  
            end)  
        end  
    end)  
    dragArea.InputChanged:Connect(function(input)  
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then  
            dragInput = input  
        end  
    end)  
    UserInputService.InputChanged:Connect(function(input)  
        if input == dragInput and dragging then  
            local delta = input.Position - dragStart  
            frameToMove.Position = UDim2.new(  
                startPos.X.Scale, startPos.X.Offset + delta.X,  
                startPos.Y.Scale, startPos.Y.Offset + delta.Y  
            )  
        end  
    end)  
end

local function findAdminPanel() 
    return PlayerGui:FindFirstChild("AdminPanel") 
end  

local function findPlayerButton(targetPlayer)  
    local adminPanel = findAdminPanel()  
    if not adminPanel then return nil end  
    local tName, tDisplay = targetPlayer.Name, targetPlayer.DisplayName  
    for _, desc in pairs(adminPanel:GetDescendants()) do  
        if desc:IsA("TextButton") or desc:IsA("ImageButton") then  
            local t = desc:IsA("TextButton") and desc.Text or (desc:FindFirstChildWhichIsA("TextLabel", true) and desc:FindFirstChildWhichIsA("TextLabel", true).Text or "")
            if t == tDisplay or t:find(tDisplay) or t == tName or t:find(tName) then return desc end  
        end  
    end  
    return nil  
end  

local function getCommandButtons()  
    local btns = {}  
    local adminPanel = findAdminPanel()  
    if not adminPanel then return btns end  
    for _, desc in pairs(adminPanel:GetDescendants()) do  
        if desc:IsA("TextButton") or desc:IsA("ImageButton") then  
            local t = desc:IsA("TextButton") and desc.Text or (desc:FindFirstChildWhichIsA("TextLabel", true) and desc:FindFirstChildWhichIsA("TextLabel", true).Text or "")
            if t and t ~= "" and (t:match("^:") or t:match("^;")) then table.insert(btns, {button = desc, name = t}) end  
        end  
    end  
    return btns  
end  

local function clickButton(button)  
    pcall(function()  
        for _, cx in pairs(getconnections(button.MouseButton1Click)) do cx:Fire() end  
        for _, cx in pairs(getconnections(button.Activated)) do cx:Fire() end  
    end)  
end  

local function isExactCommand(buttonName, expectedCmdName)  
    local bName = string.lower(string.match(buttonName, "^%s*(.-)%s*$") or buttonName)  
    local cmdName = string.lower(expectedCmdName)  
    if bName == cmdName or bName == ":"..cmdName or bName == ";"..cmdName then return true end  
    if string.match(bName, "^[:;]?"..cmdName.."$") or string.match(bName, "^[:;]?"..cmdName.."%s") then return true end  
    return false  
end  

local function executeQPCommand(targetPlayer, cmdName, buttonInstance)  
    task.spawn(function()  
        if findAdminPanel() then  
            local cmdFound = false  
            for _, cBtn in ipairs(getCommandButtons()) do  
                if isExactCommand(cBtn.name, cmdName) then clickButton(cBtn.button) cmdFound = true break end  
            end  
            task.wait(0.05)  
            if cmdFound then  
                local pBtn = findPlayerButton(targetPlayer)  
                if pBtn then 
                    clickButton(pBtn)  
                    if buttonInstance then  
                        buttonInstance.BackgroundColor3 = Color3.fromRGB(0, 100, 200)  
                        task.delay(0.5, function() if buttonInstance then buttonInstance.BackgroundColor3 = C.iconBg end end)  
                    end  
                end  
            end  
        end  
    end)  
end

