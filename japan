-- 10. CODE HINZUFÜGEN
-- ============================================================
local function addCode(Code, fromSammy)
    Code = tostring(Code)
    if Code == "" then return end
    
    -- Prüfen ob das gleiche Wort schonmal hinzugefügt wurde (verhindert Dopplungen)
    if Code == lastAddedCode then
        return
    end
    lastAddedCode = Code
    
    -- IMMER in History speichern (NUR von Sammy)
    if fromSammy then
        saveToHistory(Code, true)
    end
    
    -- Nur weiterverarbeiten, wenn ScriptEnabled und AutoWriteEnabled
    if not _G.ScriptEnabled or not _G.AutoWriteEnabled then return end
    if not CodeTextBox then setupPaths() end
    if not CodeTextBox then return end

    table.insert(collectedCodes, Code)
    refreshGUI()

    if CodeTextBox.Text == "" then
        CodeTextBox.Text = Code
    else
        CodeTextBox.Text = CodeTextBox.Text .. Code
    end
    AddedCount = AddedCount + 1

    if _G.AutoSubmitEnabled and #collectedCodes >= _G.SubmitAfterCount then
        local success = triggerSubmit()
        if success then
            task.wait(0.03)
            table.clear(collectedCodes)
            AddedCount = 0
            refreshGUI()
            if CodeTextBox then CodeTextBox.Text = "" end
        end
    end
end

-- 11. ANNOUNCEMENT WATCHER
local function watchLabel(Label)
    if not Label:IsA("TextLabel") then return end
    local text = Label.Text
    if text == "" then return end
    
    -- Riddle Solver (wenn aktiv)
    if _G.RiddleSolverEnabled then
        local answer = answerQuestion(text)
        if answer then
            addCode(answer, true)  -- von Sammy
            return
        end
    end
    
    -- Jedes Wort als Code behandeln (nur von Sammy)
    for word in text:gmatch("%S+") do
        addCode(word, true)  -- von Sammy
    end
end

local function startAnnouncementWatcher()
    setupPaths()
    if not Announcements then return end
    for _, v in ipairs(Announcements:GetDescendants()) do
        watchLabel(v)
    end
    Announcements.DescendantAdded:Connect(watchLabel)
end

if CodeTextBox then
    CodeTextBox:GetPropertyChangedSignal("Text"):Connect(function()
        if CodeTextBox.Text == "" then 
            AddedCount = 0
            lastAddedCode = ""
        end
    end)
end

