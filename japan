-- ==========================================
-- FLASH TP
-- ==========================================
local function startFlash(prompt, slotNum)
    if isBusy then return end
    if currentMove then
        pcall(function() currentMove:Disconnect() end)
        currentMove = nil
    end
    
    local config = SLOTS[slotNum] or SLOTS[1]
    local targetPos = config.pos[1]
    if not targetPos or not Root or not Humanoid then return end
    
    local carpet = findTool(_G.SelectedCarpet)
    if carpet then
        Humanoid:UnequipTools()
        task.wait(0.05)
        Humanoid:EquipTool(carpet)
    end
    
    if Root:FindFirstChild("MoveVel") then Root.MoveVel:Destroy() end
    if Root:FindFirstChild("MoveAtt") then Root.MoveAtt:Destroy() end
    
    local att = Instance.new("Attachment")
    att.Name = "MoveAtt"
    att.Parent = Root
    
    local vel = Instance.new("LinearVelocity")
    vel.Name = "MoveVel"
    vel.Attachment0 = att
    vel.RelativeTo = Enum.ActuatorRelativeTo.World
    vel.MaxForce = math.huge
    vel.Parent = Root
    
    local reached = false
    local grabbed = false
    
    currentMove = RunService.Heartbeat:Connect(function()
        if not Root or not Root.Parent or Humanoid.Health <= 0 then
            if currentMove then pcall(function() currentMove:Disconnect() end); currentMove = nil end
            return
        end
        
        if reached then
            vel.VectorVelocity = Vector3.zero
            return
        end
        
        local pos = Root.Position
        local dir = Vector3.new(targetPos.X - pos.X, 0, targetPos.Z - pos.Z)
        local dist = dir.Magnitude
        
        if dist <= 60 and not grabbed then
            grabbed = true
            task.spawn(function() executeSteal(prompt) end)
        end
        
        local speed = 200
        if dist < 20 then
            speed = math.max(30, dist * 10)
        end
        
        if dist <= 5 then
            reached = true
            vel.VectorVelocity = Vector3.zero
            Root.AssemblyLinearVelocity = Vector3.zero
            vel:Destroy()
            att:Destroy()
            Root.CFrame = CFrame.new(targetPos)
            if currentMove then pcall(function() currentMove:Disconnect() end); currentMove = nil end
            
            task.wait(0.1)
            Camera.CameraType = Enum.CameraType.Scriptable
            Camera.CFrame = CFrame.new(targetPos + Vector3.new(0, 5, 0)) * CFrame.Angles(unpack(config.angles))
            
            local flash = findTool("flash")
            if flash then
                Humanoid:UnequipTools()
                task.wait(0.05)
                Humanoid:EquipTool(flash)
                task.wait(0.05)
                flash:Activate()
            end
            
            task.spawn(function()
                task.wait(0.5)
                blockAll()
            end)
            
            if AdminRemote then
                task.spawn(function()
                    task.wait(0.3)
                    for _, p in ipairs(Players:GetPlayers()) do
                        if p ~= LocalPlayer and p.Character then
                            pcall(function()
                                AdminRemote:InvokeServer("f888ee6e-c86d-46e1-93d7-0639d6635d42", p, "tiny")
                                task.wait(0.2)
                                AdminRemote:InvokeServer("f888ee6e-c86d-46e1-93d7-0639d6635d42", p, "rocket")
                            end)
                            break
                        end
                    end
                end)
            end
            
            if _G.AutoGiant then
                local giant = findTool("giant potion")
                if giant then
                    Humanoid:EquipTool(giant)
                    task.wait(0.08)
                    giant:Activate()
                    task.wait(0.05)
                    Humanoid:UnequipTools()
                end
            end
            
            task.wait(0.3)
            Camera.CameraType = Enum.CameraType.Custom
            return
        end
        
        local velVec = dir.Unit * speed
        vel.VectorVelocity = Vector3.new(velVec.X, 0, velVec.Z)
    end)
end

-- ==========================================
-- PET LISTE
-- ==========================================
local function getPets()
    local pets = {}
    local plots = Workspace:FindFirstChild("Plots")
    if not plots then return pets end
    
    for _, plot in ipairs(plots:GetChildren()) do
        if not isMyPlot(plot) then
            local podiums = plot:FindFirstChild("AnimalPodiums")
            if podiums then
                for _, podium in ipairs(podiums:GetChildren()) do
                    local slot = tonumber(podium.Name:match("%d+")) or 1
                    local base = podium:FindFirstChild("Base") or podium
                    local spawn = base:FindFirstChild("Spawn")
                    local att = spawn and spawn:FindFirstChild("PromptAttachment")
                    if att then
                        for _, child in ipairs(att:GetChildren()) do
                            if child:IsA("ProximityPrompt") and isValidPrompt(child) then
                                table.insert(pets, {
                                    prompt = child,
                                    slot = slot,
                                    name = child.ObjectText or "Pet"
                                })
                            end
                        end
                    end
                end
            end
        end
    end
    
    table.sort(pets, function(a, b) return a.slot < b.slot end)
    return pets
end

