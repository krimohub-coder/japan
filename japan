-- KEYBINDS
-- ==========================================
UserInputService.InputBegan:Connect(function(input, processed)
    if processed then return end
    if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
    
    if input.KeyCode == _G.Keybinds.FlashTP then
        if selectedPrompt and selectedSlotNumber then
            startTripToPetSlot(selectedPrompt, selectedSlotNumber)
        end
    elseif input.KeyCode == _G.Keybinds.Block then
        blockAllPlayers()
    elseif input.KeyCode == _G.Keybinds.Reset then
        doReset()
    end
end)

