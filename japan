local function doReset()
    if instaResetCooldown then return end
    
    pcall(function()
        if not resetRemote then
            local net = ReplicatedStorage:FindFirstChild("Packages")
            if net then net = net:FindFirstChild("Net") end
            if net then
                local children = net:GetChildren()
                for i = 1, #children - 1 do
                    if children[i] and children[i+1] and tostring(children[i].Name):find("Tools/Cooldown") then
                        resetRemote = children[i+1]
                        break
                    end
                end
            end
        end
    end)
    
    if not resetRemote then
        local h = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildWhichIsA("Humanoid")
        if h then h.Health = 0 end
        return
    end
    
    instaResetCooldown = true
    local oldChar = LocalPlayer.Character
    local GUID = "f888ee6e-c86d-46e1-93d7-0639d6635d42"
    
    task.spawn(function()
        while LocalPlayer.Character == oldChar do
            pcall(function()
                resetRemote:FireServer(GUID, LocalPlayer)
            end)
            task.wait()
        end
        instaResetCooldown = false
    end)
end

