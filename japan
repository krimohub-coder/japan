local function addCode(CD)
    if not _G.SE or not _G.AW then return end
    CD = tostring(CD)
    if CD == "" then return end
    if not CT then setupPaths() end
    if not CT then return end
    table.insert(collectedCodes, CD)
    refreshGUI()
    if CT.Text == "" then CT.Text = CD else CT.Text = CT.Text .. CD end
    AddedCount = AddedCount + 1
    if _G.AS and #collectedCodes >= _G.SC then
        local S = triggerSubmit()
        if S then
            table.clear(collectedCodes)
            AddedCount = 0
            refreshGUI()
            if CT then CT.Text = "" end
        end
    end
end

