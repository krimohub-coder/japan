-- ==========================================
-- DO RESET (INSTA-RESET)
-- ==========================================
local resetRemote = nil
local instaResetCooldown = false

local oldFireServer
oldFireServer = hookfunction(Instance.new("RemoteEvent").FireServer, newcclosure(function(self, ...)
    if not resetRemote and self.Name:sub(1, 3) == "RE/" then
        resetRemote = self
    end
    return oldFireServer(self, ...)
end))

local function doReset()
    local lp = Players.LocalPlayer
    if instaResetCooldown then return end
    
    if not resetRemote then
        local Net = ReplicatedStorage:WaitForChild("Packages", 2):WaitForChild("Net", 2)
        if Net then
            local childs = Net:GetChildren()
            for i = 1, #childs - 1 do
                if childs[i] and childs[i+1] and childs[i].Name:find("Tools/Cooldown") then
                    resetRemote = childs[i+1]
                    break
                end
            end
        end
    end

    if not resetRemote then
        local h = lp.Character and lp.Character:FindFirstChildWhichIsA("Humanoid")
        if h then h.Health = 0 end
        return
    end

    instaResetCooldown = true
    local oldChar = lp.Character
    local GUID = "f888ee6e-c86d-46e1-93d7-0639d6635d42"
    
    task.spawn(function()
        while lp.Character == oldChar do
            pcall(function()
                resetRemote:FireServer(GUID, lp)
            end)
            task.wait()
        end
        instaResetCooldown = false
    end)
end

