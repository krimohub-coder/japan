local function refreshGUI()
    if not MainFrame then return end
    local CF = MainFrame:FindFirstChild("ContentFrame")
    if not CF then return end
    local CL = CF:FindFirstChild("CollectedLabel")
    if CL then CL.Text = "Collected: " .. #collectedCodes end
    local LF = CF:FindFirstChild("CodeListFrame")
    if not LF then return end
    local SC = LF:FindFirstChild("Scrolling")
    if not SC then return end
    for _, CH in ipairs(SC:GetChildren()) do
        if CH:IsA("TextLabel") and CH.Name ~= "Placeholder" then CH:Destroy() end
    end
    local PH = SC:FindFirstChild("Placeholder")
    if PH then PH.Visible = (#collectedCodes == 0) end
    local MS = 10
    local SI = math.max(1, #collectedCodes - MS + 1)
    for I = SI, #collectedCodes do
        local CD = collectedCodes[I]
        if CD and CD ~= "" then
            local LB = Instance.new("TextLabel")
            LB.Name = "CodeEntry"
            LB.Size = UDim2.new(1, -6, 0, 12)
            LB.BackgroundTransparency = 1
            LB.Text = string.format("%02d  %s", I, CD)
            LB.TextColor3 = Color3.fromRGB(0, 255, 255)
            LB.Font = Enum.Font.Gotham
            LB.TextSize = 9
            LB.TextXAlignment = Enum.TextXAlignment.Left
            LB.TextYAlignment = Enum.TextYAlignment.Top
            LB.Parent = SC
        end
    end
    local LY = SC:FindFirstChildOfClass("UIListLayout")
    if LY then SC.CanvasSize = UDim2.new(0, 0, 0, LY.AbsoluteContentSize.Y + 6) end
end

