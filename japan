-- ==========================================
-- RESET
-- ==========================================
local resetRemote = nil
pcall(function()
    local oldFire = hookfunction(Instance.new("RemoteEvent").FireServer, function(self, ...)
        if not resetRemote and self.Name and string.sub(self.Name, 1, 3) == "RE/" then
            resetRemote = self
        end
        return oldFire(self, ...)
    end)
end)

local function doReset()
    pcall(function()
        if not resetRemote then
            local h = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildWhichIsA("Humanoid")
            if h then h.Health = 0 end
            return
        end
        resetRemote:FireServer("f888ee6e-c86d-46e1-93d7-0639d6635d42", LocalPlayer)
    end)
end

