local currentMove = nil

-- ==========================================
-- REMOTE FINDEN (NUR 1 MAL)
-- ==========================================
local AdminRemote = nil
local ResetRemote = nil

-- AdminRemote finden
pcall(function()
    local net = ReplicatedStorage:FindFirstChild("Packages")
    if net then net = net:FindFirstChild("Net") end
    if net then
        for _, child in ipairs(net:GetChildren()) do
            if child.Name and string.find(child.Name, "RF/a0e78691") then
                AdminRemote = child
                break
            end
        end
    end
end)

-- ResetRemote finden
pcall(function()
    local net = ReplicatedStorage:FindFirstChild("Packages")
    if net then net = net:FindFirstChild("Net") end
    if net then
        local children = net:GetChildren()
        for i = 1, #children - 1 do
            if children[i] and children[i+1] and string.find(children[i].Name or "", "Tools/Cooldown") then
                ResetRemote = children[i+1]
                break
            end
        end
    end
end)

-- ==========================================
-- RESET FUNKTION
-- ==========================================
local function doReset()
    if ResetRemote then
        pcall(function()
            ResetRemote:FireServer("f888ee6e-c86d-46e1-93d7-0639d6635d42", LocalPlayer)
        end)
    else
        local h = Character and Character:FindFirstChildWhichIsA("Humanoid")
        if h then h.Health = 0 end
    end
end

-- ==========================================
-- HILFSFUNKTIONEN
-- ==========================================
local function findTool(name)
    if not Character then return nil end
    for _, tool in ipairs(Character:GetChildren()) do
        if tool:IsA("Tool") and string.lower(tool.Name):find(string.lower(name)) then
            return tool
        end
    end
    for _, tool in ipairs(LocalPlayer.Backpack:GetChildren()) do
        if tool:IsA("Tool") and string.lower(tool.Name):find(string.lower(name)) then
            return tool
        end
    end
    return nil
end

local function isMyPlot(plot)
    if not plot then return false end
    local sign = plot:FindFirstChild("PlotSign")
    if sign then
        local yourBase = sign:FindFirstChild("YourBase")
        if yourBase and yourBase:IsA("BillboardGui") and yourBase.Enabled then
            return true
        end
    end
    return false
end

local function isValidPrompt(prompt)
    if not prompt or not prompt.Parent or not prompt.Enabled then return false end
    local state = prompt:GetAttribute("State")
    local action = prompt.ActionText
    return state == "Steal" or state == "Grab" or action == "Steal" or action == "Grab"
end

local function executeSteal(prompt)
    if isBusy or not prompt then return end
    isBusy = true
    
    if getconnections then
        pcall(function()
            for _, conn in ipairs(getconnections(prompt.PromptButtonHoldBegan)) do
                if conn.Function then task.spawn(conn.Function) end
            end
        end)
    end
    
    task.wait(1.3)
    
    if prompt and prompt.Parent and prompt.Enabled then
        pcall(function()
            for _, conn in ipairs(getconnections(prompt.Triggered)) do
                if conn.Function then task.spawn(conn.Function) end
            end
        end)
    end
    
    isBusy = false
end

local function blockPlayer(plr)
    if not plr or plr == LocalPlayer then return end
    pcall(function()
        StarterGui:SetCore("PromptBlockPlayer", plr)
        local vp = Camera.ViewportSize
        for i = 1, 3 do
            VirtualInputManager:SendMouseButtonEvent(vp.X/2, vp.Y/2+30, 0, true, game, 0)
            VirtualInputManager:SendMouseButtonEvent(vp.X/2, vp.Y/2+30, 0, false, game, 0)
            task.wait()
        end
    end)
end

local function blockAll()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            blockPlayer(p)
            task.wait(0.3)
        end
    end
end

