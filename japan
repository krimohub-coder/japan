local function triggerSubmit()
    setupPaths()
    if CB and CB.Parent then
        pcall(function()
            CB:CaptureFocus()
            CB:ReleaseFocus(true)
        end)
        return true
    end
    local PG = L:FindFirstChild("PlayerGui")
    if PG then
        for _, OB in ipairs(PG:GetDescendants()) do
            if OB:IsA("TextButton") or OB:IsA("ImageButton") then
                local TX = (OB:IsA("TextButton") and OB.Text or ""):lower()
                if TX:find("submit") or TX:find("redeem") or TX:find("confirm") or TX:find("einlösen") then
                    pcall(function()
                        OB:CaptureFocus()
                        OB:ReleaseFocus(true)
                    end)
                    return true
                end
            end
        end
    end
    return false
end

