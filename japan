local espEnabled = false
local activeTimers = {}
local lastESPUpdate = 0

-- Timer ESP
local function updateTimers()
    if not _G.TimerESP then
        for plot, data in pairs(activeTimers) do
            if data.billboard then data.billboard:Destroy() end
            activeTimers[plot] = nil
        end
        return
    end
    
    local now = tick()
    if now - lastESPUpdate < 0.5 then return end
    lastESPUpdate = now
    
    local plotsFolder = Workspace:FindFirstChild("Plots")
    if not plotsFolder then return end
    
    for _, plot in ipairs(plotsFolder:GetChildren()) do
        if not activeTimers[plot] then
            pcall(function()
                local purchases = plot:FindFirstChild("Purchases")
                local block = purchases and purchases:FindFirstChild("PlotBlock")
                local main = block and block:FindFirstChild("Main")
                if main then
                    local bb = Instance.new("BillboardGui")
                    bb.Name = "TimerESP"
                    bb.Adornee = main
                    bb.Size = UDim2.new(0, 70, 0, 18)
                    bb.MaxDistance = math.huge
                    bb.StudsOffset = Vector3.new(0, -3.5, 0)
                    bb.AlwaysOnTop = true
                    bb.Parent = plot
                    
                    local frame = Instance.new("Frame")
                    frame.Size = UDim2.new(1, 0, 1, 0)
                    frame.BackgroundTransparency = 0.15
                    frame.BackgroundColor3 = Color3.fromRGB(10, 20, 40)
                    frame.Parent = bb
                    Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 6)
                    
                    local stroke = Instance.new("UIStroke")
                    stroke.Color = C.accent
                    stroke.Thickness = 0.8
                    stroke.Parent = frame
                    
                    local lbl = Instance.new("TextLabel")
                    lbl.Size = UDim2.new(1, 0, 1, 0)
                    lbl.BackgroundTransparency = 1
                    lbl.Text = "--:--"
                    lbl.TextColor3 = C.accentHi
                    lbl.Font = Enum.Font.GothamBold
                    lbl.TextSize = 9
                    lbl.TextXAlignment = Enum.TextXAlignment.Center
                    lbl.Parent = frame
                    
                    activeTimers[plot] = { billboard = bb, label = lbl }
                end
            end)
        end
        
        local data = activeTimers[plot]
        if data and data.label then
            pcall(function()
                local purchases = plot:FindFirstChild("Purchases")
                local block = purchases and purchases:FindFirstChild("PlotBlock")
                local main = block and block:FindFirstChild("Main")
                local timerGui = main and main:FindFirstChild("BillboardGui")
                local timerLabel = timerGui and timerGui:FindFirstChild("RemainingTime")
                if timerLabel then
                    data.label.Text = timerLabel.Text
                end
            end)
        end
    end
end

