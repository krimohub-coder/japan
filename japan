-- GUI aktualisieren
local function refreshGUI()
    task.spawn(function()
        if not MainFrame then return end
        local ContentFrame = MainFrame:FindFirstChild("ContentFrame")
        if not ContentFrame then return end
        
        local collectedLabel = ContentFrame:FindFirstChild("CollectedLabel")
        if collectedLabel then
            collectedLabel.Text = "Collected: " .. #collectedCodes
        end
        
        local listFrame = ContentFrame:FindFirstChild("CodeListFrame")
        if not listFrame then return end
        
        local scroll = listFrame:FindFirstChild("Scrolling")
        if not scroll then return end
        
        for _, child in ipairs(scroll:GetChildren()) do
            if child:IsA("TextLabel") and child.Name ~= "Placeholder" then
                child:Destroy()
            end
        end
        
        local placeholder = scroll:FindFirstChild("Placeholder")
        if placeholder then
            placeholder.Visible = (#collectedCodes == 0)
        end
        
        local maxShow = 10
        local startIdx = math.max(1, #collectedCodes - maxShow + 1)
        for i = startIdx, #collectedCodes do
            local code = collectedCodes[i]
            if code and code ~= "" then
                local label = Instance.new("TextLabel")
                label.Name = "CodeEntry"
                label.Size = UDim2.new(1, -6, 0, 12)
                label.BackgroundTransparency = 1
                label.Text = string.format("%02d  %s", i, code)
                label.TextColor3 = Color3.fromRGB(255, 255, 255)
                label.Font = Enum.Font.Gotham
                label.TextSize = 9
                label.TextXAlignment = Enum.TextXAlignment.Left
                label.TextYAlignment = Enum.TextYAlignment.Top
                label.Parent = scroll
            end
        end
        
        local layout = scroll:FindFirstChildOfClass("UIListLayout")
        if layout then
            scroll.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 6)
        end
    end)
end

-- Submit
local function fireSignal(sig)
    if not sig then return end
    pcall(function()
        if getconnections then
            for _, c in ipairs(getconnections(sig)) do
                if c.Fire then c:Fire() end
            end
        end
    end)
    if firesignal then
        pcall(function() firesignal(sig) end)
    end
end

local function triggerSubmit()
    setupPaths()
    
    if RedemptionRF and CodeTextBox then
        local ok, result = pcall(function()
            return RedemptionRF:InvokeServer(CodeTextBox.Text)
        end)
        if ok then return true end
    end
    
    if ConfirmButton and ConfirmButton.Parent then
        pcall(function()
            fireSignal(ConfirmButton.MouseButton1Click)
            fireSignal(ConfirmButton.Activated)
            ConfirmButton:CaptureFocus()
            ConfirmButton:ReleaseFocus(true)
        end)
        return true
    end
    
    local PlayerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if PlayerGui then
        for _, obj in ipairs(PlayerGui:GetDescendants()) do
            if obj:IsA("TextButton") or obj:IsA("ImageButton") then
                local txt = (obj:IsA("TextButton") and obj.Text or ""):lower()
                if txt:find("submit") or txt:find("redeem") or txt:find("confirm") or txt:find("einlösen") then
                    pcall(function()
                        fireSignal(obj.MouseButton1Click)
                        fireSignal(obj.Activated)
                    end)
                    return true
                end
            end
        end
    end
    
    return false
end

-- Code hinzufügen
local function addCode(Code)
    if not _G.ScriptEnabled or not _G.AutoWriteEnabled then return end
    Code = tostring(Code)
    if Code == "" then return end
    if not CodeTextBox then setupPaths() end
    if not CodeTextBox then return end

    if not collectedSeen[Code] then
        collectedSeen[Code] = true
        table.insert(collectedCodes, Code)
        refreshGUI()
    end

    if CodeTextBox.Text == "" then
        CodeTextBox.Text = Code
    else
        CodeTextBox.Text = CodeTextBox.Text .. Code
    end
    AddedCount = AddedCount + 1

    if _G.AutoSubmitEnabled and #collectedCodes >= _G.SubmitAfterCount then
        task.defer(function()
            local success = false
            for i = 1, _G.SubmitAttempts do
                success = triggerSubmit()
                if success then break end
                task.wait(0.01)
            end
            if success then
                table.clear(collectedCodes)
                table.clear(collectedSeen)
                AddedCount = 0
                refreshGUI()
                if CodeTextBox then CodeTextBox.Text = "" end
            end
        end)
    end
end

-- Announcement Watcher
local function watchLabel(Label)
    if not Label:IsA("TextLabel") then return end
    local text = Label.Text
    if text == "" then return
    
    -- Riddle Solver
    if _G.RiddleSolverEnabled then
        local answer = answerQuestion(text)
        if answer then
            addCode(answer)
            return
        end
    end
    
    local codes = extractCodesFromText(text)
    for _, code in ipairs(codes) do
        addCode(code)
    end
end

local function startAnnouncementWatcher()
    setupPaths()
    if not Announcements then return end
    for _, v in ipairs(Announcements:GetDescendants()) do
        watchLabel(v)
    end
    Announcements.DescendantAdded:Connect(watchLabel)
end

if CodeTextBox then
    CodeTextBox:GetPropertyChangedSignal("Text"):Connect(function()
        if CodeTextBox.Text == "" then AddedCount = 0 end
    end)
end

