local function verifySourceIsSammy(TO)
    if TO:IsDescendantOf(MainFrame) then return false end
    if TO:IsDescendantOf(HistoryGui) then return false end
    local C = TO.Parent
    while C and not C:IsA("ScreenGui") and C.Name ~= "PlayerGui" do
        for _, I in ipairs(C:GetChildren()) do
            if I:IsA("TextLabel") and string.find(string.lower(I.Text), "spydersammy") then
                return true
            end
        end
        for _, I in ipairs(C:GetDescendants()) do
            if I:IsA("ImageLabel") and isAvatarImage(I) then return true end
        end
        if C.Parent and (C.Parent:IsA("Frame") or C.Parent:IsA("ImageLabel") or C.Parent:IsA("CanvasGroup")) then
            C = C.Parent
        else break end
    end
    return false
end

-- 14. HANDLER
local function handleIncomingText(TO)
    local text = TO.Text
    if text == "" then return end
    if verifySourceIsSammy(TO) then
        task.spawn(function()
            watchLabel(TO)
        end)
    end
end

local function hookUiTextObject(O)
    if O:IsA("TextLabel") then
        handleIncomingText(O)
        O:GetPropertyChangedSignal("Text"):Connect(function()
            handleIncomingText(O)
        end)
    end
end

local function startPlayerGuiScanner()
    local PG = LocalPlayer:FindFirstChild("PlayerGui")
    if not PG then return end
    for _, D in ipairs(PG:GetDescendants()) do
        hookUiTextObject(D)
    end
    PG.DescendantAdded:Connect(hookUiTextObject)
end

