-- Code-Erkennung
local function looksLikeCode(token)
    if not token then return false end
    if #token < 4 or #token > 50 then return false end
    return token:match("^[A-Za-z0-9]+$") ~= nil
end

local function extractCodesFromText(text)
    local found = {}
    if not text or text == "" then return found end
    local clean = text:gsub("<[^>]+>", ""):gsub("[%p%s]", " ")
    for token in clean:gmatch("%S+") do
        if looksLikeCode(token) then
            table.insert(found, token)
        end
    end
    return found
end

