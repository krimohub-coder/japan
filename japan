local function findTool(name)
    if not Character then return nil end
    for _, tool in ipairs(Character:GetChildren()) do
        if tool:IsA("Tool") and string.lower(tool.Name):find(string.lower(name)) then
            return tool
        end
    end
    for _, tool in ipairs(LocalPlayer.Backpack:GetChildren()) do
        if tool:IsA("Tool") and string.lower(tool.Name):find(string.lower(name)) then
            return tool
        end
    end
    return nil
end

local function isMyPlot(plot)
    if not plot then return false end
    local sign = plot:FindFirstChild("PlotSign")
    if sign then
        local yourBase = sign:FindFirstChild("YourBase")
        if yourBase and yourBase:IsA("BillboardGui") and yourBase.Enabled then
            return true
        end
    end
    return false
end

local function isValidPrompt(prompt)
    if not prompt or not prompt.Parent or not prompt.Enabled then return false end
    local state = prompt:GetAttribute("State")
    local action = prompt.ActionText
    return state == "Steal" or state == "Grab" or action == "Steal" or action == "Grab"
end

local function executeSteal(prompt)
    if isBusy or not prompt then return end
    isBusy = true
    if getconnections then
        pcall(function()
            for _, conn in ipairs(getconnections(prompt.PromptButtonHoldBegan)) do
                if conn.Function then task.spawn(conn.Function) end
            end
        end)
    end
    task.wait(1.3)
    if prompt and prompt.Parent and prompt.Enabled then
        pcall(function()
            for _, conn in ipairs(getconnections(prompt.Triggered)) do
                if conn.Function then task.spawn(conn.Function) end
            end
        end)
    end
    isBusy = false
end

local function blockPlayer(plr)
